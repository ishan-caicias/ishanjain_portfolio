{
  "name": "ishanjain-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:report": "vitest run --coverage && node scripts/coverage-report.mjs",
    "test:e2e": "playwright test",
    "test:e2e:space-scene": "node scripts/run-space-scene-e2e.mjs",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@pmndrs/detect-gpu": "^6.0.13",
    "astro": "^7.0.7",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@gltf-transform/cli": "^4.4.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.1",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-playwright": "^2.2.2",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^1.7.0",
    "jsdom": "^29.1.1",
    "meshoptimizer": "^1.2.0",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
