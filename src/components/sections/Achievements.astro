---
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Card from "@/components/ui/Card.astro";
import { achievements } from "@/content/achievements";
import { iconPaths as iconMap } from "@/content/icons";
---

<section
  id="achievements"
  class="px-6 py-24"
  aria-label="Selected achievements"
>
  <div class="mx-auto max-w-6xl">
    <SectionHeading
      title="Selected Achievements"
      subtitle="Outcomes delivered in production"
    />

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        achievements.map((achievement) => (
          <Card>
            <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-royal-700/50">
              <svg
                class="h-5 w-5 text-gold-400"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d={iconMap[achievement.icon] || iconMap.shield}
                />
              </svg>
            </div>
            <h3 class="font-heading text-lg font-semibold text-text-primary">
              {achievement.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-text-muted">
              {achievement.description}
            </p>
          </Card>
        ))
      }
    </div>
  </div>
</section>
