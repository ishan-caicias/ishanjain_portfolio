---
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Card from "@/components/ui/Card.astro";
import { credibilityItems } from "@/content/credibility";
---

<section id="about" class="px-6 py-24" aria-label="Core competencies">
  <div class="mx-auto max-w-6xl">
    <SectionHeading
      title="What I Do"
      subtitle="Core engineering strengths, built through production delivery across domains"
    />

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        credibilityItems.map((item) => (
          <Card>
            <h3 class="font-heading text-lg font-semibold text-gold-400">
              {item.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-text-muted">
              {item.description}
            </p>
          </Card>
        ))
      }
    </div>
  </div>
</section>
