---
import SpaceScene from "@/components/islands/SpaceScene";
import AstronautMascot from "@/components/islands/AstronautMascot";
---

<section
  id="hero"
  class="relative flex min-h-screen flex-col items-center justify-end overflow-hidden px-6"
  aria-label="Introduction"
>
  <!-- Interactive WebGL space scene: 168,959 real Hipparcos/Gaia/SDSS objects, warp travel
       between sections. Fixed-position, covers the full viewport regardless of where it's
       mounted in the DOM - see PF-07 delivery plan. -->
  <SpaceScene client:load />

  <!-- Astronaut (hidden on mobile) -->
  <div class="pointer-events-none absolute inset-0 hidden md:block">
    <AstronautMascot client:idle />
  </div>

  <!-- Content -->
  <!-- PF-08 F0 landing layout (TR-022): the ship owns the upper viewport; the
       copy sits below it in a wide, two-line-max band. Hidden while
       body.ij-loading (SpaceScene clears it when the scene is ready). -->
  <div
    id="ij-hero-copy"
    class="relative z-10 mx-auto mt-auto max-w-6xl pb-14 text-center"
  >
    <div
      id="ij-hero-badge"
      class="mb-4 inline-flex items-center gap-2 rounded-full border border-royal-700/50 bg-surface-elevated/80 px-4 py-1.5 text-sm text-text-muted backdrop-blur-sm"
    >
      <span
        class="inline-block h-2 w-2 rounded-full bg-pine-500 animate-pulse"
        aria-hidden="true"></span>
      Sydney, AU
    </div>

    <h1
      class="font-heading text-3xl font-bold leading-tight text-text-primary md:whitespace-nowrap md:text-5xl"
    >
      Reliable systems, <span class="text-gold-400">thoughtful products.</span>
    </h1>

    <p
      class="mx-auto mt-4 max-w-4xl text-lg leading-relaxed text-text-muted md:text-xl"
    >
      Sydney-based software engineer with a product mindset — .NET, event-driven
      architectures, and distributed systems. I build fault-tolerant backends
      and keep production rock-solid.
    </p>

    <p
      class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-text-dim md:text-base"
    >
      C# / .NET · AWS · distributed systems · APIs · testing · safe delivery
    </p>

    <!-- Mobile touch hint (design_handoff_mobile_responsive): replaces the desktop drag/
         keyboard instructions (which live in the now mobile-hidden HUD) with touch-appropriate
         copy. Shown only on mobile while in travel mode - see the body.ij-travel rule in
         global.css. -->
    <p
      id="ij-touch-hint"
      class="mt-4 hidden font-mono text-[11px] tracking-[0.12em] text-royal-300"
      aria-hidden="true"
    >
      DRAG TO LOOK AROUND · TAP A CRAFT TO TRAVEL
    </p>

    <div
      class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center"
    >
      <a
        href="#projects"
        class="inline-flex items-center gap-2 rounded-lg bg-royal-600 px-6 py-3 font-medium text-text-primary transition-all hover:bg-royal-500 hover:shadow-lg hover:shadow-royal-600/25"
      >
        View my work
        <svg
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M19 9l-7 7-7-7"></path>
        </svg>
      </a>
      <a
        href="#contact"
        class="inline-flex items-center gap-2 rounded-lg border border-royal-600 px-6 py-3 font-medium text-text-muted transition-all hover:border-gold-500/50 hover:text-gold-400"
      >
        Get in touch
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2" aria-hidden="true">
    <div
      class="flex h-8 w-5 items-start justify-center rounded-full border-2 border-royal-500/50 p-1"
    >
      <div class="h-2 w-1 animate-bounce rounded-full bg-royal-400"></div>
    </div>
  </div>
</section>
